# ============================================================
# REQUIRED — app will not work in production without these
# ============================================================

# Admin login (server-side only — NEVER prefix with NEXT_PUBLIC_)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=pick-a-strong-password

# Signs the admin session cookie (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Public Vercel Blob storage — profile, projects, case studies and other public portfolio data
# Get from Vercel dashboard → Storage → public Blob store → .env.local
BLOB_READ_WRITE_TOKEN=

# Private Vercel Blob storage — contact messages, newsletter subscribers, bookings, leads and analytics
# Create/connect a PRIVATE Blob store to Production and use its read/write token here.
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Public site URL — used by sitemap, OG tags, canonical links, JSON-LD
NEXT_PUBLIC_SITE_URL=https://emmanuelinambao.com

# ============================================================
# REQUIRED FOR CONTACT FORM (at least one)
# ============================================================

# Web3Forms (browser fallback; key is intentionally public) — https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Formspree (server-side fallback) — https://formspree.io
FORMSPREE_ID=

# Optional server-side email provider. Use a verified sender domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Destination for Resend owner notifications (defaults to denuelinambao@gmail.com).
# Web3Forms/Formspree use the recipient configured in their own dashboards.
NOTIFICATION_EMAIL=denuelinambao@gmail.com

# ============================================================
# REQUIRED FOR MEDIA UPLOADS (admin and client testimonials)
# ============================================================

# Cloudinary — https://cloudinary.com/console
# Either use CLOUDINARY_URL or all three separate values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ============================================================
# AI — Groq portfolio assistant + case study generator
# ============================================================

# Server-side only. Create/manage at https://console.groq.com/keys
GROQ_API_KEY=

# Optional global default. Current production-safe default in code:
GROQ_MODEL=openai/gpt-oss-20b

# Optional per-feature overrides
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_CASE_STUDY_MODEL=openai/gpt-oss-20b
